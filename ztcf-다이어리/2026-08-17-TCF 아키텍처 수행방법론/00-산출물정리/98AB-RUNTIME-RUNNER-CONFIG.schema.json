{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nsight:runtime-runner:config:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["environment","identity","load","metrics","actions"],
  "properties": {
    "environment": {"type":"string","minLength":1},
    "identity": {
      "type":"object",
      "required":["git_commit","artifact_version","config_version","service_id","hostname","tomcat_jvm_instance","db_target"],
      "properties": {
        "git_commit":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
        "artifact_version":{"type":"string","minLength":1},
        "config_version":{"type":"string","minLength":1},
        "service_id":{"type":"string","minLength":1},
        "hostname":{"type":"string","minLength":1,"not":{"const":"UNKNOWN"}},
        "tomcat_jvm_instance":{"type":"string","minLength":1,"not":{"const":"UNKNOWN"}},
        "db_target":{"type":"string","minLength":1}
      }
    },
    "load": {
      "type":"object",
      "required":["base_url","path","request_body_file"],
      "properties": {
        "base_url":{"type":"string","minLength":1},
        "path":{"type":"string","minLength":1},
        "request_body_file":{"type":"string","minLength":1},
        "threads":{"type":"integer","minimum":1},
        "duration_sec":{"type":"integer","minimum":1}
      }
    },
    "metrics":{"type":"object"},
    "actions":{"type":"object"}
  }
}

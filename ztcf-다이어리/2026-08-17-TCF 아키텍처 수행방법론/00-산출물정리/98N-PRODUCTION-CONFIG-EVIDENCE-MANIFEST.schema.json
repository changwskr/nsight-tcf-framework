{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nsight:production-config-evidence-manifest:1.0",
  "title": "NSIGHT Production Config Evidence Manifest",
  "type": "object",
  "required": ["schema_version", "environment", "hostname", "captured_at", "evidence_class", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "environment": {"enum": ["PROD", "DR", "STG", "DEV", "TEST"]},
    "hostname": {"type": "string", "minLength": 2, "not": {"enum": ["UNKNOWN", "N/A", "NONE"]}},
    "captured_at": {"type": "string", "format": "date-time"},
    "evidence_class": {"const": "PRODUCTION_RUNTIME"},
    "collector": {"type": "string"},
    "source_version": {"type": "string"},
    "notes": {"type": "string"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "component": {"enum": ["APACHE", "TOMCAT", "SPRING", "RUNTIME", "DEPLOYMENT", "L4", "GSLB", "OTHER"]},
          "instance_id": {"type": "string"},
          "application_id": {"type": "string"},
          "source_path_on_host": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSIGHT ADR Approval Record",
  "type": "object",
  "required": [
    "adr_id",
    "decision",
    "approver",
    "decision_date",
    "evidence_ref"
  ],
  "properties": {
    "adr_id": {
      "type": "string",
      "pattern": "^ADR-"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "DEFER"
      ]
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "evidence_ref": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comment": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

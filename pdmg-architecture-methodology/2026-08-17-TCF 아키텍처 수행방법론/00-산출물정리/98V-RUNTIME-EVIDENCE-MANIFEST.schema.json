{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nsight:runtime-evidence:manifest:1.0",
  "title": "NSIGHT Runtime Evidence Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version","run_id","timestamp","environment","evidence_class","synthetic",
    "git_commit","artifact_version","config_version","service_id","guid","hostname",
    "tomcat_jvm_instance","db_target"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"enum": [
      "RUN-TIMEOUT","RUN-P600","RUN-P1200","RUN-S1800","RUN-HIKARI","RUN-SLOWSQL",
      "RUN-N1","RUN-SESSION","RUN-CF","RUN-TRACE","RUN-ROLLING","RUN-JWT-ROTATE"
    ]},
    "timestamp": {"type": "string", "minLength": 10},
    "environment": {"type": "string", "minLength": 1},
    "evidence_class": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "artifact_version": {"type": "string", "minLength": 1},
    "config_version": {"type": "string", "minLength": 1},
    "service_id": {"type": "string", "minLength": 1},
    "guid": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
    "hostname": {"type": "string", "minLength": 1, "not": {"const": "UNKNOWN"}},
    "tomcat_jvm_instance": {"type": "string", "minLength": 1, "not": {"const": "UNKNOWN"}},
    "db_target": {"type": "string", "minLength": 1}
  }
}

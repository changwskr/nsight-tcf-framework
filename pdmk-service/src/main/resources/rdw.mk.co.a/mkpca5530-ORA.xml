<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nhnis.mk.co.a.dao.mkpca5530Dao">

    <sql id="mkpca5530Columns">
               T1.L5101 AS l5101
             , T1.L5102 AS l5102
             , T1.L5103 AS l5103
             , T1.L5104 AS l5104
    </sql>

    <select id="mkpca5530S0_S0" resultType="nhnis.mk.co.a.dto.mkpca5530DtoOut"
            parameterType="nhnis.mk.co.a.dto.mkpca5530DtoIn">
        SELECT * FROM (
          SELECT a.*, ROWNUM rnum
            FROM (
               SELECT /*+ INDEX(T1 TB_MK_CO_A_5530_PK) */ /* mkpca5530S0_S0 */
               <include refid="mkpca5530Columns"/>
                 FROM TB_MK_CO_A_5530 T1
                WHERE 1 = 1
               <if test="trtBrc != null and trtBrc != ''">
                  AND T1.L5104 = #{trtBrc}
               </if>
               <if test="basDt != null and basDt != ''">
                  AND T1.L5103 = #{basDt}
               </if>
               ORDER BY T1.L5101
            ) a
           WHERE ROWNUM &lt;= #{offset} + #{pageSize}
        )
        WHERE rnum > #{offset}
    </select>

    <select id="mkpca5530S0_S0_count" resultType="int"
            parameterType="nhnis.mk.co.a.dto.mkpca5530DtoIn">
        SELECT COUNT(*)
          FROM TB_MK_CO_A_5530 T1
         WHERE 1 = 1
        <if test="trtBrc != null and trtBrc != ''">
           AND T1.L5104 = #{trtBrc}
        </if>
        <if test="basDt != null and basDt != ''">
           AND T1.L5103 = #{basDt}
        </if>
    </select>

</mapper>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsight.nh.local/harness/schemas/workflow-definition.schema.json",
  "title": "Harness Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "harness.nsight/v1"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runType",
        "concurrency",
        "stages"
      ],
      "properties": {
        "runType": {
          "type": "string"
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectLock",
            "moduleWriteLock"
          ],
          "properties": {
            "projectLock": {
              "enum": [
                "NONE",
                "READ",
                "WRITE",
                "EXCLUSIVE"
              ]
            },
            "moduleWriteLock": {
              "type": "boolean"
            }
          }
        },
        "defaults": {
          "type": "object",
          "properties": {
            "timeoutSeconds": {
              "type": "integer"
            },
            "maxAttempts": {
              "type": "integer"
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "order",
        "dependsOn",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "gate": {
          "type": "string"
        },
        "humanApproval": {
          "type": "boolean",
          "default": false
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "agent",
        "contract",
        "timeoutSeconds",
        "retryPolicy",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "inputSchema",
            "outputSchema"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "inputSchema": {
              "type": "string"
            },
            "outputSchema": {
              "type": "string"
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "retryPolicy": {
          "enum": [
            "NONE",
            "TOOL_STANDARD",
            "LLM_STANDARD",
            "BUILD_REPAIR"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
